{
  "name": "physio-clinic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs && pnpm -C server install && pnpm -C client install",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "seed": "pnpm -C server seed",
    "dev": "pnpm db:up && pnpm seed && concurrently -n server,client -c blue,magenta \"pnpm -C server dev\" \"pnpm -C client dev\"",
    "dev:server": "pnpm -C server dev",
    "dev:client": "pnpm -C client dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
