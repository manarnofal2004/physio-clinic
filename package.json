{
  "name": "physio-clinic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs && pnpm -C backend install && pnpm -C frontend install",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "seed": "pnpm -C backend seed",
    "dev": "node scripts/db-up.mjs && pnpm seed && concurrently -n backend,frontend -c blue,magenta \"pnpm -C backend dev\" \"pnpm -C frontend dev\"",
    "dev:backend": "pnpm -C backend dev",
    "dev:frontend": "pnpm -C frontend dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
