PORT=5000
MONGODB_URI=mongodb://localhost:27017/physio-clinic
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# One URL, or several separated by commas
CLIENT_URL=http://localhost:5173
CLINIC_TIMEZONE=Asia/Hebron

# Optional: first admin created by `pnpm seed` (defaults: admin@clinic.com / Admin12345)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: number of proxies in front of the server when deployed (for rate limits)
TRUST_PROXY=0
